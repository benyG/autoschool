# Seule la clé est requise : les modèles se choisissent dans la barre latérale
# de l'application (liste construite depuis ceux auxquels votre projet a accès).
OPENAI_API_KEY=sk-...

# Optionnel — surcharge les modèles par défaut
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_TTS_MODEL=tts-1
